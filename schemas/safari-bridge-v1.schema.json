{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tryhunch.ca/schemas/safari-bridge-v1.schema.json",
  "title": "Hunch Safari bridge protocol v1",
  "$defs": {
    "binding": {
      "type": "object",
      "required": ["tabId", "expectedUrl", "expectedOrigin", "generation"],
      "properties": {
        "tabId": { "type": "integer" },
        "windowId": { "type": ["integer", "null"] },
        "windowLease": { "type": "string" },
        "expectedUrl": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "expectedOrigin": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "generation": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "required": ["action", "ref"],
          "properties": {
            "action": { "const": "click" },
            "ref": { "type": "string", "pattern": "^e[1-9][0-9]*$" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["action", "text"],
          "properties": {
            "action": { "const": "type" },
            "ref": { "type": "string", "pattern": "^e[1-9][0-9]*$" },
            "text": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["action", "ref", "checked"],
          "properties": {
            "action": { "const": "check" },
            "ref": { "type": "string", "pattern": "^e[1-9][0-9]*$" },
            "checked": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["action", "url"],
          "properties": {
            "action": { "const": "navigate" },
            "url": { "type": "string", "format": "uri" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["action", "x", "y"],
          "properties": {
            "action": { "const": "click_xy" },
            "x": { "type": "number" },
            "y": { "type": "number" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["action", "from_x", "from_y", "to_x", "to_y"],
          "properties": {
            "action": { "const": "drag" },
            "from_x": { "type": "number" },
            "from_y": { "type": "number" },
            "to_x": { "type": "number" },
            "to_y": { "type": "number" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["action", "key"],
          "properties": {
            "action": { "const": "key" },
            "ref": { "type": "string", "pattern": "^e[1-9][0-9]*$" },
            "key": { "type": "string" },
            "modifiers": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "type": "object",
  "required": ["protocol", "id", "token", "operation", "payload"],
  "properties": {
    "protocol": { "const": 1 },
    "id": { "type": "string", "format": "uuid" },
    "token": { "type": "string", "minLength": 32 },
    "operation": {
      "enum": ["status", "open", "tabs", "switch_tab", "snapshot", "act"]
    },
    "payload": {
      "type": "object",
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "index": { "type": "integer", "minimum": 0 },
        "tabId": { "type": "integer" },
        "windowId": { "type": ["integer", "null"] },
        "windowLease": { "type": "string" },
        "newWindow": { "type": "boolean" },
        "captureScreenshot": { "type": "boolean" },
        "expectedUrl": { "type": "string", "format": "uri" },
        "expectedOrigin": { "type": "string", "format": "uri" },
        "generation": { "type": "string" },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" }, "maxItems": 50 },
        "detailed": { "type": "boolean" },
        "postcondition": {
          "type": ["object", "null"],
          "properties": {
            "ref": { "type": "string", "pattern": "^e[1-9][0-9]*$" },
            "field": { "enum": ["value", "title", "enabled", "selected", "expanded"] },
            "equals": {}
          },
          "required": ["ref", "field", "equals"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
