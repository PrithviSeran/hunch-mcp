{
  "manifest_version": 2,
  "name": "Hunch",
  "description": "Focus-free Safari control for the Hunch MCP server.",
  "version": "0.1.0",
  "icons": {
    "48": "images/icon-48.png",
    "64": "images/icon-64.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },
  "browser_action": {
    "default_title": "Hunch",
    "default_icon": {
      "16": "images/icon-16.png",
      "19": "images/icon-32.png",
      "32": "images/icon-32.png",
      "38": "images/icon-64.png"
    }
  },
  "permissions": ["nativeMessaging", "tabs", "<all_urls>"],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
